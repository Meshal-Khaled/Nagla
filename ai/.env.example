# Vision (computer vision): fake | gemini
VISION_PROVIDER=fake
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_TIMEOUT_S=60
# When Gemini is busy (503 / 429) each room is retried after these waits (seconds); optional second model for the last tries
# GEMINI_RETRY_WAITS_S=2,5,10
# GEMINI_FALLBACK_MODEL=

# AI filtering (second pass on the detected list): none | claude
AI_FILTER=none
CLAUDE_API_KEY=
CLAUDE_BASE_URL=https://api.anthropic.com/v1
CLAUDE_MODEL=claude-haiku-4-5
# CLAUDE_TIMEOUT_S=90

# Moving plan (booking step 5): on when CLAUDE_API_KEY is set (same Claude settings as the filter); "none" turns it off
# AI_PLANNER=claude
