NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000
DATABASE_URL=postgres://nagla:nagla@localhost:5433/nagla
TEST_DATABASE_URL=postgres://nagla:nagla@localhost:5433/nagla_test
# Furniture catalog (separate database, seeded from src/db/seed/catalog.json)
CATALOG_DATABASE_URL=postgres://nagla:nagla@localhost:5433/nagla_catalog
TEST_CATALOG_DATABASE_URL=postgres://nagla:nagla@localhost:5433/nagla_catalog_test
# Password given to every seeded dev user
SEED_PASSWORD=nagla-dev-pass

# Required in production (32+ chars each)
# JWT_SECRET=
# FILE_SIGNING_SECRET=

# Photo files (default: ../storage)
# STORAGE_DIR=
AI_URL=http://localhost:8000

# Google sign-in (optional, second option next to email + password)
# Android app: only GOOGLE_CLIENT_ID (the Web client ID) is needed; an Android OAuth client for
# com.nagla.app + the signing SHA-1 must exist in the same Google Cloud project.
# Web dev UI redirect flow: also GOOGLE_CLIENT_SECRET and GOOGLE_REDIRECT_URI.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
# APP_REDIRECT_URL=http://localhost:3000/dev/index.html
# Public deployment (HTTPS in front of port 3000), e.g.:
# PUBLIC_URL=https://nagla.arc-homlab.com
# GOOGLE_REDIRECT_URI=https://nagla.arc-homlab.com/auth/google/callback
# APP_REDIRECT_URL=https://nagla.arc-homlab.com/dev/index.html

# Push notifications (optional): path to a Firebase service account JSON
# FIREBASE_SERVICE_ACCOUNT=

# Hudhud Maps (optional; without it the app uses the phone's own geocoder and an OpenStreetMap map)
# Secret key: geocoding/search on the server. Publishable key (pk_...) + map id: map tiles in the app.
# HUDHUD_SECRET_KEY=
# HUDHUD_PUBLISHABLE_KEY=
# HUDHUD_MAP_ID=
