{
  "name": "nagla-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "migrate": "tsx src/db/migrate.ts latest",
    "migrate:down": "tsx src/db/migrate.ts down",
    "migrate:reset": "tsx src/db/migrate.ts reset",
    "seed": "tsx src/db/seed/index.ts",
    "db:types": "kysely-codegen --numeric-parser number --date-parser string --out-file src/db/types.ts && kysely-codegen --numeric-parser number --url env(CATALOG_DATABASE_URL) --out-file src/db/catalog/types.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "worker": "tsx src/worker.ts",
    "worker:dev": "tsx watch src/worker.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.7",
    "@fastify/static": "^10.1.10",
    "@node-rs/argon2": "^2.2.2",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.8",
    "firebase-admin": "^14.5.0",
    "jose": "^6.2.15",
    "kysely": "^0.29.8",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "kysely-codegen": "^0.20.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
