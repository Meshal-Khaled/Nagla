<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- the system splash (Android 12+) shows the mark for a moment, then the animated Compose splash plays -->
    <style name="Theme.Naqla.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#F2F7F6</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Naqla</item>
    </style>
    <style name="Theme.Naqla" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
